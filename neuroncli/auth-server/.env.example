# Operator configuration only. Never distribute this file with real secrets.
AUTH_HOST=127.0.0.1
AUTH_PORT=8787
NEURON_API_ONLY=true
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SESSION_TTL_HOURS=24
GATEWAY_ADMIN_TOKEN=
