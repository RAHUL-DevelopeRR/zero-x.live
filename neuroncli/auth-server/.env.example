# Operator configuration only. Never distribute this file with real secrets.
AUTH_HOST=127.0.0.1
AUTH_PORT=8787
NEURON_API_ONLY=true
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SESSION_TTL_HOURS=24
GATEWAY_ADMIN_TOKEN=
# Owner lineup (2026-10-29), as in wrangler.toml [vars]: Groq, Claude, OpenRouter, NVIDIA and
# Z.ai. Leave GROQ_MODELS, NVIDIA_MODELS and ZAI_MODELS unset: an empty list switches its
# provider off. NVIDIA_HOSTED and OPENROUTER_HOSTED are the owner's decision.
GROQ_API_KEY=
NVIDIA_HOSTED=true
NVIDIA_API_KEY=
OPENROUTER_HOSTED=true
OPENROUTER_API_KEY=
OPENROUTER_MODELS=cohere/north-mini-code:free,minimax/minimax-m3.1-flash:free
# Claude Sonnet 5.5 and Opus 5.5 (paid pools, Pro and Max).
ANTHROPIC_API_KEY=
ANTHROPIC_MODELS=claude-sonnet-5-5,claude-opus-5-5
# Z.ai free GLM-4.7-Flash and GLM-4.5-Flash (key slot zai.free).
GLM_API_KEY=
# Gemini and Workers AI are switched off with empty lists; delete these two lines to serve them.
GEMINI_API_KEY=
GEMINI_MODELS=
CLOUDFLARE_MODELS=
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=
BEDROCK_API_KEY=
BEDROCK_REGION=
