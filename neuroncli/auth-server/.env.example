GROQ_MODELS=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
GEMINI_API_KEY=
# Owner lineup (2026-10-29): Gemini and Workers AI are switched off with empty lists, as in
# wrangler.toml [vars]; delete these two lines to serve them.
GEMINI_MODELS=
CLOUDFLARE_MODELS=
GLM_API_KEY=
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=
BEDROCK_API_KEY=
