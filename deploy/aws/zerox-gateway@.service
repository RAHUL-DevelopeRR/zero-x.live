# Zero-X gateway (neuroncli/auth-server/server.js) on the EC2 VM: website, sign-in, accounts,
# /v1 streams, billing and admin. Users reach it only through Cloudflare Tunnel (cloudflared dials
# out; this listens on loopback). deploy/aws/README.md.
#
# Two instances, zerox-gateway@0 and zerox-gateway@1, so a deploy never refuses a connection:
# both listen on 127.0.0.1:8787 with reusePort, and each also answers GET /ready and GET /health
# on its own loopback READY_PORT (8790 for @0, 8791 for @1), so the deploy can check the one it
# just started. activate-release.sh starts the idle instance on the new release, waits for its
# /ready, then stops the old one, which drains its streams while the new one takes every new
# connection. host-setup.sh installs this file and enables @0 for boot.
#
# Each instance runs the release its own link names: /opt/zerox/instance-N -> /opt/zerox/releases/<commit>.
# activate-release.sh changes a link only while its instance is stopped, so a running instance,
# and a restart of it after a crash (Restart=always), always gets the release it was started on;
# after a deploy both links name the live release. /opt/zerox/current (the cron, operators)
# flips only once a release has passed its checks.
[Unit]
Description=Zero-X gateway (Node), instance %i
Documentation=https://github.com/RAHUL-DevelopeRR/zero-x.live/tree/main/deploy/aws
Wants=network-online.target
# Ordering only: on reboot or shutdown systemd stops units in reverse order, so the gateway
# drains its streams while cloudflared, which carries them, is still up.
After=network-online.target cloudflared.service
# Nothing to start before the first release (host-setup.sh enables @0 for boot ahead of it).
ConditionPathExists=/opt/zerox/instance-%i/neuroncli/auth-server/server.js

[Service]
Type=simple
User=zerox
Group=zerox
# The paths go through the instance's link and are resolved when the process starts.
WorkingDirectory=/opt/zerox/instance-%i/neuroncli/auth-server
# Read by systemd as root before the service starts; secrets never reach argv or the unit.
EnvironmentFile=/etc/zerox/gateway.env
Environment=NODE_ENV=production AUTH_HOST=127.0.0.1 AUTH_PORT=8787 AUTH_REUSE_PORT=true READY_PORT=879%i
# The VM serves the website from the instance's release (server.js serves only what .assetsignore allows).
Environment=ASSETS_DIR=/opt/zerox/instance-%i
Environment=TRUST_CLOUDFLARE=true TRUST_CF_IPCOUNTRY=true
ExecStart=/usr/bin/node /opt/zerox/instance-%i/neuroncli/auth-server/server.js
Restart=always
RestartSec=2
# SIGTERM drains: no new connections, in-flight streams get SHUTDOWN_GRACE_MS (110 s) to finish
# and settle, then exit; streams still running are cut and get 5 s to settle. TimeoutStopSec
# must stay above the grace plus that tail.
KillSignal=SIGTERM
TimeoutStopSec=120
TimeoutStartSec=30
LimitNOFILE=65536

# Sandboxing. Node needs none of these privileges. Not set: MemoryDenyWriteExecute (V8's JIT
# needs writable executable memory) and ProcSubset=pid (os.cpus() and os.totalmem() read /proc).
# RemoveIPC acts only when the last unit running as zerox stops, so one instance stopping leaves
# the other alone.
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RemoveIPC=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
