# /etc/zerox/gateway.env: every variable the Zero-X gateway (neuroncli/auth-server) reads in
# production on the Oracle VM. NAMES ONLY: never commit a value. Reference: GATEWAY_SETUP.md.
#
# .github/workflows/deploy-oracle.yml writes this file on every deploy (deploy/aws/gateway-env.mjs):
#   [vars]   value copied from neuroncli/auth-server/wrangler.toml [vars], as the Worker gets it
#   secret   the GitHub Actions secret of the same name that deploy.yml binds to the Worker
#            (required: SUPABASE_SECRET_KEY and the parity secrets SESSION_ENCRYPTION_KEY,
#            PROVIDER_KEYS_KEK and DEVICE_APPROVAL_SECRET; the others are skipped with a warning)
#   manual   not written by the workflow: add it to wrangler.toml [vars] (plain values) or to
#            both workflows (secrets) when it is needed, since the deploy replaces hand edits
# systemd reads the file as root (EnvironmentFile=), so it is 0600 and owned by the deploy user.
# EnvironmentFile= overrides the unit's Environment=, so gateway-env.mjs refuses the runtime
# names below and the development-only ones at the end of this file.
# Syntax: KEY="value" (\ " ` $ escaped by a backslash). Comments only on their own lines: systemd
# would read a trailing "# ..." as part of the value.

# ── Runtime: set in zerox-gateway.service, not here ──
# NODE_ENV=production refuses PGlite and the dev identity.
# AUTH_HOST=127.0.0.1: only cloudflared on the same VM reaches the server.
# AUTH_PORT=8787, the tunnel's origin port.
# NEURON_API_ONLY=true: API only, no website assets.
# TRUST_CLOUDFLARE=true: per-IP limits use CF-Connecting-IP from the loopback peer; the dev
#   identity is refused.
# TRUST_CF_IPCOUNTRY=true: the caller country (free-pool geo rules) comes from CF-IPCountry.
# SHUTDOWN_GRACE_MS= (110000 by default): the SIGTERM drain, then 5 s for cut streams to settle;
#   TimeoutStopSec=120 is above both. Change it in the unit together with TimeoutStopSec.
# SSE_HEARTBEAT_MS= (30000 by default): keep-alive comment on a quiet event stream.

# ── Identity and database ──
# [vars] Supabase project URL (Auth and PostgREST RPCs)
SUPABASE_URL=
# [vars] public sb_publishable_ key
SUPABASE_PUBLISHABLE_KEY=
# secret, required: server-only sb_secret_ key for every RPC
SUPABASE_SECRET_KEY=
# [vars] sign-in providers offered
SUPABASE_AUTH_PROVIDERS=
# manual: SUPABASE_ANON_KEY= (legacy JWT, read when SUPABASE_PUBLISHABLE_KEY is unset)
# manual: SUPABASE_STORAGE_KEY= (browser storage key, default zerox-supabase-auth)

# ── Sessions, security and operator access ──
# [vars] CLI session lifetime in hours (default 720)
CLI_SESSION_TTL_HOURS=
# [vars] sliding-expiry ceiling in days after sign-in (default 90)
CLI_SESSION_MAX_DAYS=
# [vars] lifetime of sessions from before hashed storage
SESSION_TTL_HOURS=
# secret, required: seals users' own OpenRouter keys in session records (the Worker's value)
SESSION_ENCRYPTION_KEY=
# secret, required: device sign-in approval (the Worker's value)
DEVICE_APPROVAL_SECRET=
# secret: operator APIs and the full /health
GATEWAY_ADMIN_TOKEN=
# secret, required: provider key vault encryption key (the Worker's value)
PROVIDER_KEYS_KEK=
# [vars] true enforces the Content-Security-Policy header
CSP_ENFORCE=
# [vars] upgrade_url in errors
PRICING_URL=
# manual: DEVICE_VERIFICATION_URL= (device sign-in page shown to the CLI)
# manual: CF_ACCESS_TEAM_DOMAIN= and CF_ACCESS_AUD= (Cloudflare Access on the operator APIs; put
#   them in wrangler.toml [vars] when the Worker enforces Access, README section 4)
# manual secret: OIOP_SIGNING_JWK= (Ed25519 JWK that signs offer manifests)
# manual: OIOP_SCRUB= (prompt secret scrubber: all by default, untrusted or off)

# ── Billing (Razorpay; checkout and webhooks stay on the Worker) ──
# [vars] public key id
RAZORPAY_KEY_ID=
# secret: REST calls and checkout signatures
RAZORPAY_KEY_SECRET=
# secret: webhook HMAC
RAZORPAY_WEBHOOK_SECRET=

# ── Upstream providers (owner lineup 2026-10-29: Groq, Claude, OpenRouter, NVIDIA, Z.ai) ──
# secret: Groq free pool
GROQ_API_KEY=
# secret: Groq paid pool (Pro and Max)
GROQ_PAID_API_KEY=
# secret: Gemini free pool (off while GEMINI_MODELS is empty)
GEMINI_API_KEY=
# secret: Gemini paid pool
GEMINI_PAID_API_KEY=
# [vars] an empty list switches Gemini off by configuration
GEMINI_MODELS=
# [vars] true: the NVIDIA trial key serves free models
NVIDIA_HOSTED=
# secret
NVIDIA_API_KEY=
# [vars] true: the operator key serves the OpenRouter free models
OPENROUTER_HOSTED=
# secret
OPENROUTER_API_KEY=
# [vars] OpenRouter models offered
OPENROUTER_MODELS=
# [vars] BYOK PKCE callback
OPENROUTER_CALLBACK_URL=
# secret: Claude paid pools and the weekly discovery research
ANTHROPIC_API_KEY=
# [vars] Claude models on the anthropic.paid key
ANTHROPIC_MODELS=
# secret: Z.ai free GLM Flash models
GLM_API_KEY=
# [vars] an empty list switches Workers AI off by configuration
CLOUDFLARE_MODELS=
# [vars] optional Azure health-probe adapter
AZURE_OPENAI_ENDPOINT=
AZURE_API_VERSION=
# Leave unset (an empty list switches the provider off): GROQ_MODELS= NVIDIA_MODELS= ZAI_MODELS=
# manual: OPENROUTER_FREE_ONLY= (BYOK discovery filter)
# manual: ANTHROPIC_THINKING_REPLAY= (false stops replaying signed thinking blocks)
# manual: CLOUDFLARE_ACCOUNT_ID= and CLOUDFLARE_API_TOKEN= serve Workers AI over REST (the VM has
#   no AI binding). Only with a token scoped to Workers AI, never the deploy token. Optional:
#   auto no longer uses Llama and the lineup switches Workers AI off.
# manual: CLOUDFLARE_PAID= (paid Workers AI pools, Workers Paid accounts only)
# manual, optional operator adapters (PROVIDERS.md): OMNIROUTE_API_KEY= OMNIROUTE_BASE_URL=
#   OMNIROUTE_MODELS= BEDROCK_API_KEY= BEDROCK_REGION= BEDROCK_ENDPOINT= BEDROCK_MODELS=
#   AWS_REGION= AZURE_OPENAI_API_KEY= AZURE_MODELS=
# manual: DISCOVERY_KEY_<ID>= and DISCOVERY_BASE_<ID>= (a discovered provider's verification
#   key and https base)

# ── Routing, timeouts and limits (all manual; defaults in GATEWAY_SETUP.md) ──
# UPSTREAM_TTFB_TIMEOUT_MS= (45000)
# UPSTREAM_IDLE_TIMEOUT_MS= (90000). A non-streaming answer may take the failover budget plus
#   this (140 s), past Cloudflare's 125 s; 70000 keeps it under (README, "Timeouts").
# UPSTREAM_FAILOVER_BUDGET_MS= (50000; a stream's first byte, keep it well under 125 s)
# ROUTER_MAX_ATTEMPTS= (3)  ROUTER_MAX_RATE_LIMITED= (6)
# RESERVATION_RENEW_MS= (30000)  RESERVATION_LEASE_SECONDS= (90)
# PAID_DAILY_SPEND_CAP_USD= (lowers every paid pool's daily cap)
# CATALOG_SOURCE= (code: kill switch, the code catalog only)

# ── Background jobs (scripts/cron.mjs from zerox-cron.timer) and feeds (all manual) ──
# DISCOVERY_ENABLED= (false stops the discovery tick)
# DISCOVERY_RESEARCH= (false stops the weekly Claude research and credits jobs)
# DISCOVERY_RESEARCH_MAX_USD= (spend cap of one research run)
# DISCOVERY_CREDITS= (false stops the credits job)
# MODELS_STREAM_INTERVAL_MS= and MODELS_STREAM_LIFETIME_MS= (/v1/models update stream)
# EXPO_ACCESS_TOKEN= (secret, Expo push for the mobile app)
# GITHUB_RELEASES_TOKEN= (secret, GitHub API token for the changelog feed)

# ── Never on the VM (development and tests only; gateway-env.mjs refuses them) ──
# DEV_AUTH_ENABLED= ALLOW_ANONYMOUS_SESSIONS= ALLOW_UNKNOWN_COUNTRY= DATABASE_DRIVER=
# PGLITE_DATA_DIR= ALLOW_LOCAL_DATABASE= RAZORPAY_API_BASE=
