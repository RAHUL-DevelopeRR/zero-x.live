# Zero-X gateway API (neuroncli/auth-server/server.js) on the Oracle VM, reached only through
# Cloudflare Tunnel (cloudflared dials out; this listens on loopback). deploy/oracle/README.md.
#   sudo install -m 0644 zerox-gateway.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now zerox-gateway
[Unit]
Description=Zero-X gateway API (Node)
Documentation=https://github.com/RAHUL-DevelopeRR/zero-x.live/tree/main/deploy/oracle
Wants=network-online.target
# Ordering only: on reboot or shutdown systemd stops units in reverse order, so the gateway
# drains its streams while cloudflared, which carries them, is still up.
After=network-online.target cloudflared.service

[Service]
Type=simple
User=zerox
Group=zerox
# /opt/zerox/gateway is a symlink to the current release (deploy-oracle.yml swaps it).
WorkingDirectory=/opt/zerox/gateway
# Read by systemd as root before the service starts; secrets never reach argv or the unit.
EnvironmentFile=/etc/zerox/gateway.env
Environment=NODE_ENV=production AUTH_HOST=127.0.0.1 AUTH_PORT=8787 NEURON_API_ONLY=true
Environment=TRUST_CLOUDFLARE=true TRUST_CF_IPCOUNTRY=true
ExecStart=/usr/bin/node /opt/zerox/gateway/server.js
Restart=always
RestartSec=2
# SIGTERM drains: no new connections, in-flight streams get SHUTDOWN_GRACE_MS (110 s) to finish
# and settle, then exit; streams still running are cut and get 5 s to settle. TimeoutStopSec
# must stay above the grace plus that tail.
KillSignal=SIGTERM
TimeoutStopSec=120
TimeoutStartSec=30
LimitNOFILE=65536

# Sandboxing. Node needs none of these privileges. Not set: MemoryDenyWriteExecute (V8's JIT
# needs writable executable memory) and ProcSubset=pid (os.cpus() and os.totalmem() read /proc).
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RemoveIPC=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
